---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ashwini Vapilkar — Software Developer | Frontend & AI Applications",
  description = "Portfolio of Ashwini Vapilkar, Software Developer specializing in React.js, JavaScript ES6+, responsive UI architecture, REST APIs, and AI-powered web applications."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://ashwinivapilkar.dev');
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Ashwini Vapilkar" />
    <meta name="keywords" content="Ashwini Vapilkar, Frontend Developer, React.js Developer, JavaScript Developer, Web Developer Portfolio, Responsive Web Design, Tailwind CSS, Techsevin Solution, Ambab Infotech" />
    <meta name="theme-color" content="#090d16" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.svg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/og-image.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

    <!-- Theme Initialization Script (prevents FOUC) -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'light') {
          document.documentElement.classList.remove('dark');
        } else if (storedTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          // Default to dark mode for sleek developer aesthetic
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Ashwini Vapilkar",
      "jobTitle": "Software Developer | Frontend & AI Applications",
      "worksFor": {
        "@type": "Organization",
        "name": "Techsevin Solution LLP"
      },
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "SVKM's Usha Pravin Gandhi College of Arts, Science & Commerce"
      },
      "sameAs": [
        "https://github.com/AshwiniVapilkar",
        "https://www.linkedin.com/in/ashwini-vapilkar-3978b7290/"
      ],
      "knowsAbout": [
        "Frontend Development",
        "React.js",
        "JavaScript",
        "Tailwind CSS",
        "Responsive UI Engineering",
        "Figma to Code",
        "REST APIs",
        "WordPress",
        "Magento"
      ]
    })} />
  </head>
  <body class="selection:bg-sky-500 selection:text-white transition-colors duration-300">
    <div class="min-h-screen flex flex-col relative bg-[var(--bg-primary)] text-[var(--text-primary)] transition-colors duration-300">
      <slot />
    </div>
  </body>
</html>
