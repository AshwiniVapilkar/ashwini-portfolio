---
const email = "vapilkarashwini3@gmail.com";
const linkedinUrl = "https://www.linkedin.com/in/ashwini-vapilkar-3978b7290/";
const githubUrl = "https://github.com/AshwiniVapilkar";
---

<section id="contact" class="py-20 md:py-28 relative overflow-hidden">
  <!-- Subtle Glow Effect -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-sky-500/5 blur-3xl rounded-full pointer-events-none"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-8">
    
    <!-- Header -->
    <div class="space-y-4">
      <span class="text-xs font-mono-code tracking-wider uppercase text-sky-600 dark:text-sky-400 font-semibold px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/20 inline-block">
        06 / Let's Connect
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[var(--text-primary)]">
        Have a project in mind? Let's talk.
      </h2>
      <p class="text-base sm:text-lg text-[var(--text-secondary)] max-w-xl mx-auto leading-relaxed">
        I am currently open to Frontend Developer roles, web interface design conversions, and technical collaborations. Feel free to reach out via email or connect on LinkedIn.
      </p>
    </div>

    <!-- Direct Contact Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      
      <!-- Direct Mailto CTA -->
      <a
        href={`mailto:${email}`}
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-sm font-semibold text-white bg-sky-600 hover:bg-sky-500 rounded-xl shadow-lg hover:shadow-sky-500/20 transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 active:scale-95"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>Send me an email</span>
      </a>

      <!-- Interactive Copy Email Button -->
      <button
        id="copy-email-btn"
        type="button"
        data-email={email}
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-4 text-sm font-mono-code font-medium text-[var(--text-primary)] bg-[var(--bg-card)] hover:bg-[var(--bg-card-hover)] border border-[var(--border-color)] rounded-xl transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 active:scale-95"
      >
        <svg id="copy-icon" class="w-4 h-4 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <span id="copy-btn-text">{email}</span>
      </button>
    </div>

    <!-- Social Links Grid -->
    <div class="pt-10 flex items-center justify-center gap-6 border-t border-[var(--border-subtle)] font-mono-code text-xs">
      <a
        href={linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-[var(--text-secondary)] hover:text-sky-500 transition-colors p-2 rounded-lg hover:bg-[var(--bg-secondary)]"
      >
        <svg class="w-4 h-4 fill-current text-sky-600" viewBox="0 0 24 24">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
        </svg>
        <span>LinkedIn</span>
      </a>

      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-[var(--text-secondary)] hover:text-sky-500 transition-colors p-2 rounded-lg hover:bg-[var(--bg-secondary)]"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>GitHub</span>
      </a>
    </div>

  </div>
</section>

<script>
  // Copy Email Logic
  const copyBtn = document.getElementById('copy-email-btn');
  const copyBtnText = document.getElementById('copy-btn-text');

  copyBtn?.addEventListener('click', async () => {
    const emailToCopy = copyBtn.getAttribute('data-email');
    if (!emailToCopy) return;

    try {
      await navigator.clipboard.writeText(emailToCopy);
      if (copyBtnText) {
        const originalText = copyBtnText.innerText;
        copyBtnText.innerText = 'Copied to Clipboard! ✓';
        copyBtnText.classList.add('text-emerald-500', 'font-bold');
        setTimeout(() => {
          copyBtnText.innerText = originalText;
          copyBtnText.classList.remove('text-emerald-500', 'font-bold');
        }, 2000);
      }
    } catch (err) {
      console.error('Failed to copy email', err);
    }
  });
</script>
