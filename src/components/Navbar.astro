---
const navLinks = [
  { name: 'About', href: '#about' },
  { name: 'Experience', href: '#experience' },
  { name: 'Projects', href: '#projects' },
  { name: 'Skills', href: '#skills' },
  { name: 'Contact', href: '#contact' },
];
---

<header id="main-header" class="sticky top-0 z-50 w-full backdrop-blur-md bg-[var(--bg-primary)]/85 border-b border-[var(--border-subtle)] transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo / Initials -->
    <a href="#" class="group flex items-center gap-3 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 rounded-lg p-1" aria-label="Ashwini Vapilkar - Home">
      <div class="w-9 h-9 rounded-lg bg-sky-500/10 border border-sky-500/30 flex items-center justify-center text-sky-500 font-mono-code font-bold text-sm group-hover:bg-sky-500 group-hover:text-white transition-all duration-300">
        AV
      </div>
      <div class="flex flex-col">
        <span class="font-bold tracking-tight text-sm sm:text-base text-[var(--text-primary)] group-hover:text-sky-500 transition-colors">
          Ashwini Vapilkar
        </span>
        <span class="text-[11px] font-mono-code text-[var(--text-muted)] tracking-wider uppercase">
          Frontend Developer
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Main Navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-3 py-1.5 text-xs lg:text-sm font-medium text-[var(--text-secondary)] hover:text-sky-500 hover:bg-[var(--bg-secondary)] rounded-md transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500"
        >
          {link.name}
        </a>
      ))}
    </nav>

    <!-- Right Controls: Theme Toggle & CTA -->
    <div class="flex items-center gap-3">
      <!-- Theme Switcher Button -->
      <button
        id="theme-toggle"
        type="button"
        class="p-2 text-[var(--text-secondary)] hover:text-sky-500 hover:bg-[var(--bg-secondary)] rounded-lg transition-colors border border-transparent hover:border-[var(--border-color)] focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500"
        aria-label="Toggle Light/Dark Theme"
        title="Toggle Theme"
      >
        <!-- Sun Icon (shown in Dark mode) -->
        <svg id="sun-icon" class="w-4 h-4 hidden dark:block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon Icon (shown in Light mode) -->
        <svg id="moon-icon" class="w-4 h-4 block dark:hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Desktop Resume CTA -->
      <a
        href="/resume/Ashwini_Vapilkar_Resume.pdf"
        download="Ashwini_Vapilkar_Resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-[var(--text-primary)] hover:text-sky-500 bg-[var(--bg-secondary)] hover:bg-[var(--bg-card-hover)] border border-[var(--border-color)] rounded-lg transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500"
        aria-label="Download Resume (PDF)"
        title="Download Resume (PDF)"
      >
        <svg class="w-3.5 h-3.5 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Resume</span>
      </a>

      <!-- Desktop Contact CTA -->
      <a
        href="#contact"
        class="hidden sm:inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-semibold text-white bg-sky-600 hover:bg-sky-500 rounded-lg shadow-sm transition-all duration-200 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
      >
        <span>Let's Talk</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-lg text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-secondary)] border border-[var(--border-subtle)] focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle menu"
      >
        <svg id="hamburger-icon" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-b border-[var(--border-color)] bg-[var(--bg-primary)] px-4 pt-3 pb-5 transition-all"
  >
    <div class="flex flex-col space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-item px-3 py-2.5 text-sm font-medium text-[var(--text-secondary)] hover:text-sky-500 hover:bg-[var(--bg-secondary)] rounded-md transition-colors"
        >
          {link.name}
        </a>
      ))}
      <div class="pt-3 border-t border-[var(--border-subtle)] mt-2 space-y-2">
        <a
          href="/resume/Ashwini_Vapilkar_Resume.pdf"
          download="Ashwini_Vapilkar_Resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-nav-item w-full flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-semibold text-sky-600 dark:text-sky-400 bg-sky-500/10 hover:bg-sky-500/20 border border-sky-500/20 rounded-lg transition-colors"
          aria-label="Download Ashwini Vapilkar's Resume (PDF)"
        >
          <svg class="w-4 h-4 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Download Resume (PDF)</span>
        </a>

        <a
          href="#contact"
          class="mobile-nav-item w-full flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-semibold text-white bg-sky-600 hover:bg-sky-500 rounded-lg transition-colors"
        >
          <span>Let's Talk</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Theme Toggle Logic
  const themeToggleBtn = document.getElementById('theme-toggle');
  themeToggleBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Mobile Menu Logic
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileNavItems = document.querySelectorAll('.mobile-nav-item');

  function toggleMenu() {
    const isExpanded = mobileMenuBtn?.getAttribute('aria-expanded') === 'true';
    mobileMenuBtn?.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  }

  mobileMenuBtn?.addEventListener('click', toggleMenu);

  // Close menu when link is clicked
  mobileNavItems.forEach((item) => {
    item.addEventListener('click', () => {
      if (!mobileMenu?.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });
</script>
