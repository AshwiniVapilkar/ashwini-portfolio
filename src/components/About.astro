---
const highlights = [
  {
    title: "Frontend Engineering",
    description: "Architecting responsive, reusable React.js components with clean JavaScript ES6+, HTML5, and utility-first styling with Tailwind CSS & Bootstrap.",
    icon: `<svg class="w-5 h-5 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`
  },
  {
    title: "Figma-to-UI Precision",
    description: "Translating designer mockups into pixel-perfect, accessible, and cross-browser compliant web interfaces with high fidelity.",
    icon: `<svg class="w-5 h-5 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`
  },
  {
    title: "CMS & E-Commerce Customization",
    description: "Hands-on experience extending and customizing WordPress & Magento platforms for client web applications at Techsevin Solution LLP.",
    icon: `<svg class="w-5 h-5 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>`
  },
  {
    title: "API Integration & AI Applications",
    description: "Connecting frontend UIs with RESTful backend APIs, Strapi CMS, Clerk Auth, and exploring AI integration with Gemini AI API & Python.",
    icon: `<svg class="w-5 h-5 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
  }
];
---

<section id="about" class="py-16 md:py-24 border-b border-[var(--border-subtle)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col space-y-2 mb-12">
      <span class="text-xs font-mono-code tracking-wider uppercase text-sky-600 dark:text-sky-400 font-semibold">
        01 / About Me
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)]">
        Passionate about crafting UI with clarity, speed, and standard compliance.
      </h2>
    </div>

    <!-- Editorial 2-Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Narrative Left Column -->
      <div class="lg:col-span-6 space-y-5 text-[var(--text-secondary)] leading-relaxed text-base">
        <p class="text-[var(--text-primary)] font-medium text-lg leading-snug">
          I am a Frontend Developer dedicated to building performant web applications that bridge design intent with engineering execution.
        </p>

        <p>
          During my time as a Frontend Developer at <strong class="text-[var(--text-primary)]">Techsevin Solution LLP</strong>, I have focused on translating Figma designs into responsive, cross-browser compatible user interfaces using React.js, JavaScript, Tailwind CSS, and Bootstrap. I've also worked on customizing e-commerce and content management platforms such as WordPress and Magento.
        </p>

        <p>
          Earlier, during my internship at <strong class="text-[var(--text-primary)]">Ambab Infotech Pvt. Ltd.</strong>, I honed core web fundamentals in HTML, CSS, JavaScript, and jQuery — building interactive web components and responsive page layouts, including an Amazon homepage replica.
        </p>

        <p>
          Beyond frontend UI engineering, I hold a Master's degree in Information Technology (M.Sc. IT, Grade A). My academic and project background includes working with <strong class="text-[var(--text-primary)]">REST APIs</strong>, full-stack <strong class="text-[var(--text-primary)]">AI-powered web applications</strong> (Gemini AI API, Strapi CMS), <strong class="text-[var(--text-primary)]">Python</strong>, and <strong class="text-[var(--text-primary)]">Computer Vision</strong> (OpenCV).
        </p>

        <!-- Key Specs List -->
        <div class="pt-4 grid grid-cols-2 gap-4 border-t border-[var(--border-subtle)] font-mono-code text-xs">
          <div>
            <span class="text-[var(--text-muted)] block mb-1 uppercase tracking-wider">Degree</span>
            <span class="text-[var(--text-primary)] font-semibold">M.Sc. Information Technology</span>
          </div>
          <div>
            <span class="text-[var(--text-muted)] block mb-1 uppercase tracking-wider">Location</span>
            <span class="text-[var(--text-primary)] font-semibold">Mumbai, India</span>
          </div>
        </div>
      </div>

      <!-- Highlights Right Column: Structured Cards -->
      <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {highlights.map((item) => (
          <div class="p-5 rounded-xl bg-[var(--bg-card)] border border-[var(--border-color)] hover:border-sky-500/40 transition-all duration-200 group flex flex-col justify-between">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-lg bg-sky-500/10 border border-sky-500/20 flex items-center justify-center group-hover:bg-sky-500/20 transition-colors">
                <Fragment set:html={item.icon} />
              </div>
              <h3 class="font-bold text-base text-[var(--text-primary)] group-hover:text-sky-500 transition-colors">
                {item.title}
              </h3>
              <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
