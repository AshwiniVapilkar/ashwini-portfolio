---
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-28 border-b border-[var(--border-subtle)] overflow-hidden">
  <!-- Subtle Background Grid Accent -->
  <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05] pointer-events-none bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:24px_24px]"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Content & Positioning -->
      <div class="lg:col-span-7 flex flex-col space-y-6">
        
        <!-- Status Indicator Pill -->
        <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full text-xs font-mono-code bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 w-fit">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>Available for Frontend Developer Roles</span>
        </div>

        <!-- Name & Core Title -->
        <div class="space-y-2">
          <p class="text-sm font-semibold tracking-wide uppercase text-sky-600 dark:text-sky-400 font-mono-code">
            Ashwini Vapilkar — Software Developer | Frontend & AI Applications
          </p>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[var(--text-primary)] leading-[1.15]">
            Frontend Developer building responsive, thoughtful & production-ready web interfaces.
          </h1>
        </div>

        <!-- Professional Developer Introduction -->
        <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed max-w-2xl">
          I specialize in building modular web applications with <strong class="text-[var(--text-primary)] font-medium">React.js</strong>, <strong class="text-[var(--text-primary)] font-medium">JavaScript ES6+</strong>, and <strong class="text-[var(--text-primary)] font-medium">Tailwind CSS</strong>. With hands-on experience converting complex Figma designs into clean, responsive code at Techsevin Solution LLP, I prioritize usability, performance, and cross-browser compatibility.
        </p>

        <!-- Essential Tech Pills -->
        <div class="flex flex-wrap gap-2 pt-1" aria-label="Core Technical Strengths">
          <span class="px-2.5 py-1 text-xs font-mono-code rounded-md bg-[var(--badge-bg)] text-[var(--badge-text)] border border-[var(--border-subtle)]">React.js</span>
          <span class="px-2.5 py-1 text-xs font-mono-code rounded-md bg-[var(--badge-bg)] text-[var(--badge-text)] border border-[var(--border-subtle)]">JavaScript ES6+</span>
          <span class="px-2.5 py-1 text-xs font-mono-code rounded-md bg-[var(--badge-bg)] text-[var(--badge-text)] border border-[var(--border-subtle)]">Tailwind CSS</span>
          <span class="px-2.5 py-1 text-xs font-mono-code rounded-md bg-[var(--badge-bg)] text-[var(--badge-text)] border border-[var(--border-subtle)]">Figma to UI</span>
          <span class="px-2.5 py-1 text-xs font-mono-code rounded-md bg-[var(--badge-bg)] text-[var(--badge-text)] border border-[var(--border-subtle)]">REST APIs</span>
          <span class="px-2.5 py-1 text-xs font-mono-code rounded-md bg-[var(--badge-bg)] text-[var(--badge-text)] border border-[var(--border-subtle)]">Bootstrap</span>
        </div>

        <!-- Call to Actions -->
        <div class="flex flex-wrap items-center gap-4 pt-4">
          <a
            href="#projects"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-sky-600 hover:bg-sky-500 rounded-lg shadow-sm hover:shadow-md transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 active:scale-95"
          >
            <span>View My Work</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <a
            href="/resume/Ashwini_Vapilkar_Resume.pdf"
            download="Ashwini_Vapilkar_Resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold text-sky-600 dark:text-sky-400 bg-sky-500/10 hover:bg-sky-500/20 border border-sky-500/30 rounded-lg transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 active:scale-95"
            aria-label="Download Ashwini Vapilkar's Resume (PDF)"
          >
            <svg class="w-4 h-4 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Download Resume</span>
          </a>

          <a
            href="#contact"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold text-[var(--text-primary)] bg-[var(--bg-card)] hover:bg-[var(--bg-card-hover)] border border-[var(--border-color)] rounded-lg transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 active:scale-95"
          >
            <span>Get In Touch</span>
            <svg class="w-4 h-4 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>

        <!-- Quick Meta Details -->
        <div class="pt-6 border-t border-[var(--border-subtle)] flex flex-wrap items-center gap-6 text-xs text-[var(--text-muted)] font-mono-code">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Mumbai, Maharashtra, India</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>Current: Techsevin Solution LLP</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Handcrafted Code/UI Visual Element -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-xl border border-[var(--border-color)] bg-[var(--code-bg)] text-[var(--code-text)] shadow-xl overflow-hidden font-mono-code text-xs">
          <!-- Window Header -->
          <div class="flex items-center justify-between px-4 py-3 bg-slate-900/60 border-b border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
            </div>
            <div class="text-[11px] text-slate-400 font-medium tracking-wide flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
              <span>DeveloperProfile.tsx</span>
            </div>
            <span class="text-[10px] text-slate-500">React 18</span>
          </div>

          <!-- Code Snippet Body -->
          <div class="p-4 sm:p-5 space-y-2 overflow-x-auto text-[12px] leading-relaxed">
            <p><span class="text-purple-400">interface</span> <span class="text-yellow-300">FrontendEngineer</span> {'{'}</p>
            <p class="pl-4"><span class="text-sky-300">name</span>: <span class="text-emerald-300">'Ashwini Vapilkar'</span>;</p>
            <p class="pl-4"><span class="text-sky-300">role</span>: <span class="text-emerald-300">'Software Developer | Frontend & AI'</span>;</p>
            <p class="pl-4"><span class="text-sky-300">focus</span>: <span class="text-emerald-300">['React.js', 'Responsive UI', 'Figma-to-Code']</span>;</p>
            <p class="pl-4"><span class="text-sky-300">status</span>: <span class="text-emerald-300">'Production-Ready'</span>;</p>
            <p>{'}'}</p>
            <br />
            <p><span class="text-purple-400">export const</span> <span class="text-blue-400">ProfileCard</span> = () =&#123;</p>
            <p class="pl-4"><span class="text-purple-400">return</span> (</p>
            <p class="pl-8 text-slate-400">&lt;<span class="text-rose-400">section</span> <span class="text-sky-300">className</span>=<span class="text-emerald-300">"ui-container"</span>&gt;</p>
            <p class="pl-12 text-slate-400">&lt;<span class="text-rose-400">Header</span> <span class="text-sky-300">title</span>=<span class="text-emerald-300">"Figma Precision"</span> /&gt;</p>
            <p class="pl-12 text-slate-400">&lt;<span class="text-rose-400">ComponentGrid</span> <span class="text-sky-300">responsive</span>=&#123;<span class="text-amber-300">true</span>&#125; /&gt;</p>
            <p class="pl-8 text-slate-400">&lt;/<span class="text-rose-400">section</span>&gt;</p>
            <p class="pl-4">);</p>
            <p>{'}'};</p>
          </div>

          <!-- Bottom Live Preview Box inside card -->
          <div class="border-t border-slate-800 p-3 bg-slate-950/70 flex items-center justify-between text-[11px] text-slate-400">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span>Compiled in 42ms</span>
            </div>
            <span class="text-slate-500">Cross-Browser Tested ✓</span>
          </div>
        </div>

        <!-- Floating Accent Tag -->
        <div class="absolute -bottom-4 -right-2 sm:-right-4 bg-sky-600 text-white text-[11px] font-mono-code px-3 py-1.5 rounded-lg shadow-lg border border-sky-400/30 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>React + Tailwind CSS 4</span>
        </div>
      </div>

    </div>
  </div>
</section>
