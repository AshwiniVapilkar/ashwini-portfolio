<section id="education" class="py-16 md:py-20 border-b border-[var(--border-subtle)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col space-y-2 mb-10">
      <span class="text-xs font-mono-code tracking-wider uppercase text-sky-600 dark:text-sky-400 font-semibold">
        05 / Education & Academic Background
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)]">
        Academic Qualification
      </h2>
    </div>

    <!-- Compact Education Card -->
    <div class="p-6 sm:p-8 rounded-xl bg-[var(--bg-card)] border border-[var(--border-color)] flex flex-col md:flex-row md:items-center justify-between gap-6 hover:border-sky-500/40 transition-all duration-200">
      <div class="space-y-2">
        <div class="flex items-center gap-3">
          <span class="w-10 h-10 rounded-lg bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-500 font-bold">
            🎓
          </span>
          <div>
            <h3 class="text-xl font-bold text-[var(--text-primary)]">
              M.Sc. Information Technology
            </h3>
            <p class="text-sm font-medium text-sky-600 dark:text-sky-400">
              SVKM's Usha Pravin Gandhi College of Arts, Science & Commerce
            </p>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap md:flex-col items-start md:items-end gap-3 font-mono-code text-xs">
        <span class="px-3 py-1 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 font-bold text-sm">
          Grade A
        </span>
        <span class="text-[var(--text-muted)]">
          2023 – 2025
        </span>
      </div>
    </div>

  </div>
</section>
